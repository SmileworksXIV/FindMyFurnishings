<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <Description>Keeps a searchable index of all furnishing items across all character inventories and estates that you have house editing privileges to.</Description>
    <AssemblyName>FindMyFurnishings</AssemblyName>
    <RootNamespace>FindMyFurnishings</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="images\icon.png"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('images\icon.png')" />
  </ItemGroup>

</Project>
